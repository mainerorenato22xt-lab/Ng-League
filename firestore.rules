rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() { return request.auth != null; }
    function admin() {
      return signed()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['mainerorenato22xt@gmail.com'];
    }

    // Reglas del presupuesto, mercado y draft: todos leen, solo el organizador escribe
    match /liga/{doc} {
      allow read: if true;
      allow write: if admin();
    }

    // Cada persona reclama y publica solo lo suyo; el organizador puede liberar
    match /claims/{u} {
      allow read: if true;
      allow create, update: if signed() && request.auth.uid == u;
      allow delete: if signed() && (request.auth.uid == u || admin());
    }
    match /plantillas/{u} {
      allow read: if true;
      allow create, update: if signed() && request.auth.uid == u;
      allow delete: if signed() && (request.auth.uid == u || admin());
    }
    match /perfiles/{u} {
      allow read: if true;
      allow write: if signed() && request.auth.uid == u;
    }

    // Resultados, historias y elecciones del draft: cualquier participante con sesión
    match /resultados/{doc} {
      allow read: if true;
      allow write: if signed();
    }
    match /historia/{doc} {
      allow read: if true;
      allow write: if signed();
    }
    match /draftpicks/{doc} {
      allow read: if true;
      allow create: if signed();
      allow update: if admin();
      allow delete: if admin();
    }

    // Borrador privado de cada persona
    match /usuarios/{u}/{document=**} {
      allow read, write: if signed() && request.auth.uid == u;
    }
  }
}
