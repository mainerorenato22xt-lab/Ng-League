rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() { return request.auth != null; }
    function admin() {
      return signed()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['mainerorenato22xt@gmail.com'];
    }

    // Reglas del presupuesto, mercado, equipos y fichajes: todos leen, solo el organizador escribe
    match /liga/{doc} {
      allow read: if true;
      allow write: if admin();
    }

    // Cada persona reclama y publica solo lo suyo; el organizador puede liberar
    match /claims/{u} {
      allow read: if true;
      allow create, update: if signed() && request.auth.uid == u;
      allow delete: if signed() && (request.auth.uid == u || admin());
    }
    match /plantillas/{u} {
      allow read: if true;
      allow create, update: if signed() && request.auth.uid == u;
      allow delete: if signed() && (request.auth.uid == u || admin());
    }
    match /perfiles/{u} {
      allow read: if true;
      allow write: if signed() && request.auth.uid == u;
    }

    // Resultados, historias e historias: cualquier participante con sesión
    match /resultados/{doc} {
      allow read: if true;
      allow write: if signed();
    }
    match /historia/{doc} {
      allow read: if true;
      allow write: if signed();
    }
    // Fichajes entre temporadas: ofertas y ventas de cada director técnico
    match /traspasos/{doc} {
      allow read: if true;
      allow write: if signed();
    }

    // Red NG: cada director técnico publica solo en nombre de su equipo
    match /noticias/{id} {
      allow read: if true;
      allow create: if signed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text.size() <= 500
        && exists(/databases/$(database)/documents/claims/$(request.auth.uid))
        && get(/databases/$(database)/documents/claims/$(request.auth.uid)).data.team == request.resource.data.team;
      allow update: if signed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if signed() && (resource.data.uid == request.auth.uid || admin());
    }

    // Borrador privado de cada persona
    match /usuarios/{u}/{document=**} {
      allow read, write: if signed() && request.auth.uid == u;
    }
  }
}
